{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryX provisional task contract",
  "type": "object",
  "required": ["id", "definition", "source", "proposed_gold", "gold_status", "required_fields", "constraints", "success_criteria", "protocol_assumptions", "evidence_requirements"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "source": {},
    "proposed_gold": {},
    "gold_status": {"enum": ["Pending Human Review", "human_approved"]},
    "required_fields": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "object"},
    "success_criteria": {"type": "string"},
    "protocol_assumptions": {"type": "string"},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
